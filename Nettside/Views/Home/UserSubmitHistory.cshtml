@using Nettside.Models.ViewModel
@model IEnumerable<Nettside.Models.ViewModel.AreaChangesViewModel>


@{
    ViewData["Title"] = "Overview";  // Setter tittelen på siden til "Overview".
}

<head>
    <link rel="stylesheet" href="~/css/AreaChangeOverview.css" asp-append-version="true" />
</head>


<body class="table-container">

    <div class="top-section">
        <h1 class="title">Alle saker</h1>
        <p class="fullDescription">
            Her er en oversikt over mine saker.
        </p>
    </div>


    <div class="table-box">
        <h2 class="table-title">Mine saker</h2>  



        <table class="table">

        <thead>

        <tr class="table-header">
        <th>RapportID</th>
        <th>AreaJson</th>
        <th>Beskrivelse</th>
        <th>Kommunenavn</th>
        <th>Fylkenavn</th>
         <th>Sakbehandler</th>
         <th>Status</th>
        </tr>
        </thead>
        <tbody class="table-body">

                @foreach (var change in Model)
                {
                <tr>
                    <td>@change.Id</td>
                   <td>@change.ViewAreaJson</td>
                    <td>@change.ViewDescription</td>
                     <td>@change.ViewKommunenavn</td>
                     <td>@change.ViewFylkenavn</td>
                     <td>@change.CaseHandler</td>
                      <td>@change.Status</td>

            
                </tr>
                }
        </tbody>
        </table>
    </div>
</body>
